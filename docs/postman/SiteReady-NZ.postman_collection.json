{
  "info": {
    "name": "SiteReady NZ API",
    "description": "Run in order: Register (or Login) first. Its test script saves the JWT into the {{token}} collection variable, and every later request sends it as a Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "equipmentId",
      "value": ""
    },
    {
      "key": "staffId",
      "value": ""
    },
    {
      "key": "inspectionId",
      "value": ""
    },
    {
      "key": "firstItemId",
      "value": ""
    },
    {
      "key": "today",
      "value": "2026-11-18"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register (expect 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns a token and no passwordHash', () => { pm.expect(body.token).to.be.a('string'); pm.expect(JSON.stringify(body)).to.not.include('passwordHash'); });",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Manager\",\n  \"email\": \"postman.manager@example.com\",\n  \"password\": \"a-good-password-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "POST /auth/login (expect 200 with JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a JWT', () => pm.expect(body.token.split('.')).to.have.length(3));",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.manager@example.com\",\n  \"password\": \"a-good-password-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "GET /auth/me (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Staff",
      "item": [
        {
          "name": "POST /api/staff (manager creates staff, expect 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('role is staff', () => pm.expect(pm.response.json().role).to.equal('staff'));",
                  "pm.collectionVariables.set('staffId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tane Walker\",\n  \"email\": \"tane.walker@example.com\",\n  \"password\": \"a-good-password-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/staff",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff"
              ]
            }
          }
        },
        {
          "name": "GET /api/staff (expect 200 with array)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/staff",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "POST /api/equipment (expect 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('status was calculated by the server', () => pm.expect(body.status).to.be.oneOf(['ok','due_soon','overdue','expired']));",
                  "pm.collectionVariables.set('equipmentId', body._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fire extinguisher, reception\",\n  \"type\": \"fire_extinguisher\",\n  \"location\": \"Reception\",\n  \"serialNumber\": \"FE-1001\",\n  \"purchaseDate\": \"2025-01-15\",\n  \"expiryDate\": \"2027-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment"
              ]
            }
          }
        },
        {
          "name": "GET /api/equipment (expect 200 with array)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment"
              ]
            }
          }
        },
        {
          "name": "GET /api/equipment/:id (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment",
                "{{equipmentId}}"
              ]
            }
          }
        },
        {
          "name": "PUT /api/equipment/:id (expect 200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 10);",
                  "pm.collectionVariables.set('soonDate', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status recalculated', () => pm.expect(pm.response.json().status).to.equal('due_soon'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expiryDate\": \"{{soonDate}}\"\n}"
            },
            "description": "A pre-request script sets soonDate to 10 days from today, so the status changes to due_soon.",
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment",
                "{{equipmentId}}"
              ]
            }
          }
        },
        {
          "name": "DELETE /api/equipment/:id (expect 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment",
                "{{equipmentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Inspections",
      "item": [
        {
          "name": "POST /api/inspections (manager assigns, expect 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('checklist built from the template', () => pm.expect(body.items.length).to.be.above(0));",
                  "pm.collectionVariables.set('inspectionId', body._id);",
                  "pm.collectionVariables.set('firstItemId', body.items[0].itemId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"assignedStaffId\": \"{{staffId}}\",\n  \"scheduledDate\": \"{{today}}\"\n}"
            },
            "description": "Run Staff > POST and Equipment > POST first, so equipmentId and staffId are set. Set the collection variable \"today\" to a date, YYYY-MM-DD.",
            "url": {
              "raw": "{{baseUrl}}/api/inspections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections"
              ]
            }
          }
        },
        {
          "name": "GET /api/inspections (manager, expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inspections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections"
              ]
            }
          }
        },
        {
          "name": "GET /api/inspections/assigned/:userId (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "A staff member can only ask for their own list (403 for anyone else). A manager can ask for anyone in the workspace.",
            "url": {
              "raw": "{{baseUrl}}/api/inspections/assigned/{{staffId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections",
                "assigned",
                "{{staffId}}"
              ]
            }
          }
        },
        {
          "name": "POST /api/inspections/submit (expect 200 when every item is answered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK, or 400 until every item is answered', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inspectionId\": \"{{inspectionId}}\",\n  \"submissionId\": \"postman-demo-0001\",\n  \"items\": [\n    {\n      \"itemId\": \"{{firstItemId}}\",\n      \"result\": \"pass\",\n      \"notes\": \"\"\n    }\n  ]\n}"
            },
            "description": "Every checklist item must be answered, so list every itemId from the assign response. Sending the same submissionId again returns 200 both times (safe retry).",
            "url": {
              "raw": "{{baseUrl}}/api/inspections/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections",
                "submit"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/inspections/:id/sync (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 for a completed inspection', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inspections/{{inspectionId}}/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inspections",
                "{{inspectionId}}",
                "sync"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Push notifications",
      "item": [
        {
          "name": "GET /api/push/public-key (expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has a public key and no private key', () => { const b = pm.response.json(); pm.expect(b.publicKey).to.be.a('string'); pm.expect(JSON.stringify(b)).to.not.include('private'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/push/public-key",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "push",
                "public-key"
              ]
            }
          }
        },
        {
          "name": "POST /api/push/send (manager, expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('reports devices and delivered', () => { const b = pm.response.json(); pm.expect(b.devices).to.be.a('number'); pm.expect(b.delivered).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{staffId}}\",\n  \"title\": \"Check due today\",\n  \"body\": \"Please inspect the extinguisher in reception.\",\n  \"url\": \"/inspections\"\n}"
            },
            "description": "Sends to a person in your own workspace. \"devices\" is how many phones or laptops they turned notifications on for, \"delivered\" is how many the push service accepted. Staff get 403; someone in another business gets 404. To see delivered above 0, turn reminders on in the app first, signed in as that staff member.",
            "url": {
              "raw": "{{baseUrl}}/api/push/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "push",
                "send"
              ]
            }
          }
        },
        {
          "name": "POST /api/push/run-checks (manager, expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has counts', () => { const b = pm.response.json(); pm.expect(b.reminders).to.be.a('number'); pm.expect(b.lateAlerts).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Runs the automatic checks now: reminders for checks due today or tomorrow, and alerts for checks more than a day late. The server also does this every 15 minutes by itself.",
            "url": {
              "raw": "{{baseUrl}}/api/push/run-checks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "push",
                "run-checks"
              ]
            }
          }
        }
      ]
    }
  ]
}
