{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug the API (backend)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["-r", "ts-node/register"],
      "args": ["server.ts"],
      "cwd": "${workspaceFolder}/backend",
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug the open backend test file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js",
      "args": ["${fileBasenameNoExtension}", "--runInBand", "--no-coverage"],
      "cwd": "${workspaceFolder}/backend",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug the open frontend test file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/jest/bin/jest.js",
      "args": ["${fileBasenameNoExtension}", "--runInBand", "--no-coverage"],
      "cwd": "${workspaceFolder}/frontend",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug the app in Chrome (start the frontend first)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ]
}
