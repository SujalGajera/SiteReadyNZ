# Secrets — real values live only on your machine (AGENT_RULES rule 17)
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
dev-dist/

# Log files written by the backend
logs/

# Editor and OS noise (the shared debug setup in .vscode/launch.json is kept on purpose)
.vscode/*
!.vscode/launch.json
.DS_Store
Thumbs.db
*.log
coverage/
# Folders the Postman desktop app creates at the project root if the project folder is opened in Postman
/.postman/
/postman/
# Temporary file Vite leaves behind while it loads its config
vite.config.ts.timestamp-*.mjs
