# SiteReady NZ — Frontend environment variables
# Copy this file to .env. Vite only exposes variables that start with VITE_.
# Never put secrets here: everything in this file ends up in the browser bundle.

# Where the Express API is running
VITE_API_URL=http://localhost:5000

# Public VAPID key for push notifications (the private key stays in backend/.env)
VITE_VAPID_PUBLIC_KEY=
