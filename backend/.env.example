# ============================================================
# SiteReady NZ — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# Server
PORT=5000

# MongoDB connection string — use Atlas URI in production
MONGODB_URI=mongodb://localhost:27017/siteready_nz

# JWT — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_replace_this
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 — get these from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# VAPID keys for Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@siteready.nz

# Frontend URL — used for CORS and OAuth redirect
CLIENT_URL=http://localhost:5173
